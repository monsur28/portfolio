// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id               String   @id @default(cuid())
  githubId         Int?     @unique
  name             String
  slug             String   @unique
  description      String?
  content          String?  // Rich markdown or HTML content
  htmlUrl          String
  homepage         String?
  language         String?
  topics           String   // JSON stringified array or comma-separated
  imageUrl         String?
  isFeatured       Boolean  @default(false)
  isVisible        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model LandingPage {
  id              Int      @id @default(1)
  heroName        String   @default("ABUL MONSUR")
  heroRole        String   @default("FULL-STACK DEVELOPER")
  heroDescription String   @default("I design and engineer digital experiences that turn ambitious ideas into powerful products. From high-performance websites to scalable web applications and custom business systems, I combine modern frontend architecture, robust backend engineering, and thoughtful interaction design to build technology that delivers real business value.")
  cvLink          String?  @default("https://drive.google.com/file/d/14oF0of_YtmmezXlxn_pVn_W_sM-lvaJ3/view?usp=sharing")
  location        String   @default("CHATTOGRAM, BD")
  availability    String   @default("REMOTE WORK")
  spinningText    String   @default("BUILDING SCALABLE WEB APPS")
  updatedAt       DateTime @updatedAt
}

model Post {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String    // Card summary and default meta description
  content        String    // Markdown
  coverImage     String?
  tags           String[]
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}
